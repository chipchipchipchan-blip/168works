{
  "name": "sunny-room-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25"
  },
  "scripts": {
    "dev": "node scripts/check-toolchain.mjs && vite --host 127.0.0.1",
    "build": "node scripts/check-toolchain.mjs && tsc -b && vite build && node scripts/prepare-pages.mjs",
    "preview": "node scripts/check-toolchain.mjs && vite preview --host 127.0.0.1",
    "security:check": "node scripts/check-toolchain.mjs",
    "test:security": "node --test scripts/prepare-pages.test.mjs scripts/vite-security.test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.7.3",
    "vite": "6.4.5"
  }
}
